+def _project_web_navigation(inspection, selected, explicit):
+    rulers_dir = inspection.layout.rulers_dir
+    web_prefix = f"{rulers_dir}/frontend/web/"
+    if not any(path.startswith(web_prefix) and not path.endswith("/INDEX.md") for path in explicit):
+        return
+    for path, reviewed_digest in _WEB_NAVIGATION_DIGESTS.items():
+        relative = f"{rulers_dir}/{path}"
+        if relative not in selected or relative in explicit:
+            continue
+        text = selected[relative]
+        # Every variable coordinate in these four reviewed bodies starts with this prefix.
+        template = text.replace(f"{rulers_dir}/frontend/", "{{RULERS_DIR}}/frontend/")
+        if text_sha256(template) == reviewed_digest:
+            # Check the exact rendered bytes as well (read_text normalizes line endings).
+            rendered = template.replace("{{RULERS_DIR}}", rulers_dir)
+            if text_sha256(rendered) == inspection.state["managed_files"][relative]["rendered_sha256"]:
+                selected[relative] = ""
